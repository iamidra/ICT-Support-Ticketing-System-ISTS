# ISTS - Production Environment Configuration Template
# Copy this file to .env and adjust values for your production server

APP_ENV=production
APP_NAME="ICT Support Ticketing Solution"
APP_SHORT_NAME="ISTS"
APP_VERSION="2.2.0"
APP_TIMEZONE="UTC"

# Base URL: Leave empty for automatic auto-detection, or specify subpath like /ists or full domain
BASE_URL=""

# Email Notifications
MAIL_ENABLED=false
MAIL_DRIVER=mail
MAIL_FROM="no-reply@ists.local"
MAIL_FROM_NAME="ICT Support Ticketing Solution"

# Database Configuration
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=ists_db
DB_USER=root
DB_PASS=
DB_CHARSET=utf8mb4

# Security & Session Settings
SESSION_LIFETIME=150
MAX_LOGIN_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=5

# Reverse Proxy Security
# Comma-separated list of trusted reverse proxy IPs (e.g. Cloudflare, Nginx, ALB).
# Leave empty unless running behind a known reverse proxy to prevent client IP spoofing.
TRUSTED_PROXIES=""
