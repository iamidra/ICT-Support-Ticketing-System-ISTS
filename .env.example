# ISTS - Production Environment Configuration Template
# Copy this file to .env and adjust values for your production server

APP_ENV=production
APP_NAME="ICT Support Ticketing Solution"
APP_SHORT_NAME="ISTS"
APP_VERSION="1.0.0"
APP_TIMEZONE="UTC"

# Base URL: Leave empty for automatic auto-detection, or specify subpath like /ists or full domain
BASE_URL=""

# Database Configuration
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=ists_db
DB_USER=root
DB_PASS=
DB_CHARSET=utf8mb4

# Security & Session Settings
SESSION_LIFETIME=3600
MAX_LOGIN_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15
